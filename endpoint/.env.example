# FREEDAY Gatekeeper endpoint — copy to .env and fill in. NEVER commit a filled .env.
PORT=8080

# Issued by the Agent Games dashboard after agent registration ("Rotate Secret").
# Stored on this machine in ~/workspace/agentgames/credentials.json (mode 600).
AGENT_GAMES_HMAC_SECRET=

# Official Proof Gatekeeper circuit artifacts (download from the platform):
#   https://agentgames.zkverify.io/circuits/gatekeeper.wasm
#   https://agentgames.zkverify.io/circuits/gatekeeper_final.zkey
CIRCUIT_WASM=./circuits/gatekeeper.wasm
CIRCUIT_ZKEY=./circuits/gatekeeper_final.zkey

# Proof submission (one of the two paths; Kurier recommended by the platform):
# KURIER_API_KEY=            # zkVerify mainnet API key from Kurier — signup is a user step
# KURIER_BASE_URL=https://api.kurier.xyz   # TODO: confirm exact base URL from dashboard docs
